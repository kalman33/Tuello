# --- Durcissement supply chain (Shai-Hulud & co.) ---
# N'installe aucun paquet publie depuis moins de 24 h : la plupart des
# compromissions npm sont detectees et depubliees en quelques heures.
min-release-age=1440

# Echoue sur toute vulnerabilite de severite >= high
audit-level=high

# Privilegie les paquets disposant d'une attestation de provenance
provenance=true

# NB : ne PAS activer ignore-scripts, cela casserait patch-package,
# esbuild, lmdb et @parcel/watcher.
