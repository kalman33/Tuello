{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash*)",
      "Bash(git tag*)",
      "Bash(git rev-list *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install*)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx webpack *)",
      "Bash(ls*)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__context7__get-library-docs"
    ],
    "ask": ["Bash(git push*)", "Bash(git reset --hard*)", "Bash(git rebase*)", "Bash(npm publish*)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./secrets/**)", "Bash(git push --force*)", "Bash(git push -f*)", "Bash(sudo *)", "Bash(rm -rf /*)", "Bash(rm -rf ~*)"]
  },
  "enabledMcpjsonServers": ["context7", "primeng"],
  "statusLine": { "type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/statusline.sh" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-command.js", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh", "timeout": 30 }]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh", "async": true }]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh", "async": true }]
      }
    ]
  }
}
