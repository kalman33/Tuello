{
  // Éditeur
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.addMissingImports": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.accessibilitySupport": "off",
  "editor.accessibilityPageSize": 700,
  "diffEditor.ignoreTrimWhitespace": true,

  // Formatters par langage
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode", "files.trimTrailingWhitespace": false },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // Fichiers
  "files.autoSave": "off",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/release": true,
    "**/out": true,
    "**/coverage": true,
    "**/.angular": true,
    "**/.history": true,
    "package-lock.json": true
  },
  "files.associations": {
    "CLAUDE.md": "markdown",
    ".mcp.json": "jsonc",
    ".claude/settings*.json": "jsonc"
  },

  // Explorer
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm-lock.yaml, yarn.lock, .npmrc, .nvmrc",
    "*.ts": "${capture}.spec.ts, ${capture}.test.ts, ${capture}.html, ${capture}.scss, ${capture}.css"
  },

  // Onglets : chaque fichier ouvert garde son propre onglet (pas de mode aperçu)
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  // 6 onglets maximum : à l'ouverture du 7e, le plus ancien (le moins récemment utilisé) est fermé
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 6,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.excludeDirty": true,

  // Apparence
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "vscode-icons",

  // Terminal
  "terminal.integrated.fontFamily": "Source Code Pro for Powerline",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.scrollback": 10000,

  // TypeScript / JavaScript
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // Prettier / ESLint (règles Prettier dans .prettierrc : largeur 250, quotes simples...)
  "prettier.requireConfig": true,
  "prettier.prettierPath": "./node_modules/prettier",
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "html"],

  // Git / GitHub
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.pruneOnFetch": true,
  "git.enableSmartCommit": true,
  "githubPullRequests.pullBranch": "never",

  // Correcteur orthographique
  "cSpell.language": "fr,en",
  "cSpell.enabledFileTypes": {
    "typescript": true,
    "html": true,
    "json": true,
    "markdown": true
  },
  "cSpell.words": ["anthropic", "chlog", "codejinn", "context7", "jsoneditor", "logocodejinn", "mcp", "nvmrc", "openai", "primeng", "tuello"],

  // Todo Tree
  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "XXX"]
}
