{
  "version": "0.2.0",
  "configurations": [
    {
      // Chrome avec l'extension buildée (npm run build) chargée, dans un profil dédié
      "name": "Chrome : extension Tuello (dist/tuello)",
      "type": "chrome",
      "request": "launch",
      "url": "https://example.com",
      "runtimeArgs": ["--load-extension=${workspaceFolder}/dist/tuello", "--disable-extensions-except=${workspaceFolder}/dist/tuello"],
      "userDataDir": "${workspaceFolder}/.vscode/chrome-profile",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "ng serve (localhost:4200)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "ng test (Karma)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "test",
      "url": "http://localhost:9876/debug.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Node : fichier courant",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}
